# ==============================================================================
# Meta AI App Builder Configuration (Meta-Only)
# ==============================================================================

# Default AI provider to use on server ("meta", defaults to "meta")
AI_PROVIDER=meta

# ------------------------------------------------------------------------------
# Meta AI Provider Authentication
# ------------------------------------------------------------------------------
# Server-side environment variable for Meta model API authentication
# Endpoint: https://api.meta.ai/v1/chat/completions
# Target Model: muse-spark-1.3
MODEL_API_KEY=

# ------------------------------------------------------------------------------
# Optional Provider Configurations
# ------------------------------------------------------------------------------
# Optional Meta API Base URL override (defaults to https://api.meta.ai/v1)
# META_BASE_URL=https://api.meta.ai/v1

# Optional Request Timeout in milliseconds (defaults to 600000 = 10 minutes)
# META_TIMEOUT_MS=600000

# ------------------------------------------------------------------------------
# Optional Rate Limiting & Concurrency Overrides
# ------------------------------------------------------------------------------
# RATE_LIMIT_GENERATE_MAX=5
# RATE_LIMIT_GENERATE_WINDOW_MS=60000
# RATE_LIMIT_EDIT_MAX=10
# RATE_LIMIT_EDIT_WINDOW_MS=60000
# RATE_LIMIT_AGENT_MAX=20
# RATE_LIMIT_AGENT_WINDOW_MS=60000
# MAX_CONCURRENT_MODEL_CALLS=3

# ------------------------------------------------------------------------------
# Durable Generation Job Persistence (PostgreSQL for Multi-Instance / Railway)
# ------------------------------------------------------------------------------
# In production (NODE_ENV=production), DATABASE_URL or POSTGRES_URL is required
# so jobs survive Railway container restarts and can be polled/resumed across instances.
# Example: postgres://postgres:password@roundhouse.proxy.rlwy.net:12345/railway
DATABASE_URL=
# POSTGRES_URL=

# Expiration policy for generation jobs (defaults to 3600000 = 1 hour)
# JOB_TTL_MS=3600000

# Threshold to consider an in-flight job interrupted by a server restart (defaults to 60000 = 1 minute)
# STALE_JOB_THRESHOLD_MS=60000

# Distributed resume lock TTL to prevent concurrent resume generation (defaults to 60000 = 1 minute)
# RESUME_LOCK_TTL_MS=60000

# PostgreSQL connection pool max clients (defaults to 10)
# PG_MAX_POOL=10

# PostgreSQL SSL connection setting (auto-enabled when DATABASE_URL contains sslmode=require or on Railway)
# PG_SSL=true
